# Copy to .env for local settings. These defaults use SQLite and in-process jobs.
DATABASE_URL=sqlite:///../../data/gqi.sqlite3
GQI_DATA_DIR=../../data
GQI_MAX_UPLOAD_BYTES=5368709120
GQI_ANALYSIS_TIMEOUT=3600
GQI_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
GQI_IMPORT_MAX_BYTES=1073741824
GQI_METADATA_MAX_BYTES=10485760
# Optional Hugging Face token for gated OpenGenome2 access.
# HF_TOKEN=hf_your_token

# For PostgreSQL + durable RQ jobs, run `docker compose up -d`, then uncomment:
# DATABASE_URL=postgresql+psycopg://gqi:local-development-only@localhost:5432/gqi
# GQI_REDIS_URL=redis://localhost:6379/0
