# Copy to .env in the repository root. Run API commands from apps/api.
DATABASE_URL=sqlite:///../data/gqi.sqlite3
GQI_DATA_DIR=../data
GQI_MAX_UPLOAD_BYTES=5368709120
GQI_ANALYSIS_TIMEOUT=3600
GQI_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
GQI_IMPORT_MAX_BYTES=1073741824
GQI_METADATA_MAX_BYTES=10485760
# Optional Hugging Face token for gated OpenGenome2 access.
# HF_TOKEN=<your-token>

# For PostgreSQL + durable RQ jobs, set a local password before starting Compose:
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://gqi:${POSTGRES_PASSWORD}@localhost:5432/gqi
# GQI_REDIS_URL=redis://localhost:6379/0
